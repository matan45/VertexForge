// FXAAQuality - FXAA quality presets (FXAA 3.11 presets 10 / 12 / 29 / 39)
// Use with PostProcess::setFXAAQuality(FXAAQuality::HIGH)

public class FXAAQuality {
    public static final int LOW = 0;
    public static final int MEDIUM = 1;
    public static final int HIGH = 2;
    public static final int ULTRA = 3;
}
