<?xml version="1.0" encoding="UTF-8" standalone="yes"?>
<!--
  VK-1684: the UTF-8 active code page for Editor.exe, Runtime.exe and Tests.exe (listed in their
  files {} in premake5.lua). GetACP() is then 65001 for the whole process, so argv, getenv, the CRT's
  narrow file functions, narrow std::filesystem paths and every -A Win32 call take UTF-8 strings.
  Windows 10 version 1903 or later; older Windows ignores the element and keeps the ANSI code page.
  link.exe merges this file with its default (asInvoker) manifest into the one RT_MANIFEST #1 it embeds.
-->
<assembly xmlns="urn:schemas-microsoft-com:asm.v1" manifestVersion="1.0">
  <application xmlns="urn:schemas-microsoft-com:asm.v3">
    <windowsSettings>
      <activeCodePage xmlns="http://schemas.microsoft.com/SMI/2019/WindowsSettings">UTF-8</activeCodePage>
    </windowsSettings>
  </application>
</assembly>
